# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_NAME="XIT HRM"

# local | production
APP_ENV=local

# true | false  (ignored when APP_ENV=production)
APP_DEBUG=false

APP_TIMEZONE=Asia/Dhaka

# Leave empty when the web server's document root points at public/.
# If the app is opened from a subfolder, put that URL prefix here,
# e.g. /hrm/public  (leading slash, no trailing slash)
APP_BASE_PATH=

# ------------------------------------------------------------
# Database (TCP only)
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xit_hrm
DB_USER=change_me
DB_PASS=change_me

# ------------------------------------------------------------
# Session
# ------------------------------------------------------------
SESSION_NAME=XITHRMSESSID

# ------------------------------------------------------------
# Uploads
# ------------------------------------------------------------
# Max photo size in bytes (2 MB = 2097152)
UPLOAD_MAX_BYTES=2097152